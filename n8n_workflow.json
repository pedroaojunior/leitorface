        "operation": "getAll",
        "table": "faces",
        "returnAll": true
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        900,
        420
      ],
      "id": "node-pegar-todos",
      "name": "Pegar Todos"
    },
    {
      "parameters": {
        "jsCode": "// Algoritmo de Comparacao Facial via Distancia Euclidiana\nconst webhookBody = $('Webhook').first().json.body;\nconst inputEmbedding = webhookBody.face_embedding;\nconst registeredFaces = $input.all();\n\nif (!inputEmbedding || !Array.isArray(inputEmbedding)) {\n  return [{\n    json: {\n      matchFound: false,\n      message: \"Embedding facial nao fornecido ou invalido.\"\n    }\n  }];\n}\n\nlet bestMatch = null;\nlet minDistance = 1.0;\nconst THRESHOLD = 0.55;\n\nfunction getEuclideanDistance(a, b) {\n  if (!a || !b || a.length !== b.length) return 999;\n  let sum = 0;\n  for (let i = 0; i < a.length; i++) {\n    const diff = a[i] - b[i];\n    sum += diff * diff;\n  }\n  return Math.sqrt(sum);\n}\n\nfor (const item of registeredFaces) {\n  const record = item.json;\n  let dbEmbedding = record.face_embedding;\n  if (typeof dbEmbedding === 'string') {\n    try {\n      dbEmbedding = JSON.parse(dbEmbedding);\n    } catch (e) {}\n  }\n  if (Array.isArray(dbEmbedding)) {\n    const distance = getEuclideanDistance(inputEmbedding, dbEmbedding);\n    if (distance < minDistance) {\n      minDistance = distance;\n      bestMatch = record;\n    }\n  }\n}\n\nif (bestMatch && minDistance <= THRESHOLD) {\n  const similarityPercent = Math.max(0, Math.round((1 - (minDistance / THRESHOLD)) * 100));\n  return [{\n    json: {\n      matchFound: true,\n      nome: bestMatch.nome,\n      id: bestMatch.id,\n      foto_url: bestMatch.foto_url,\n      distance: Number(minDistance.toFixed(4)),\n      similarity: similarityPercent + '%',\n      message: `Rosto reconhecido: ${bestMatch.nome}`\n    }\n  }];\n} else {\n  return [{\n    json: {\n      matchFound: false,\n      nome: null,\n      distance: Number(minDistance.toFixed(4)),\n      message: 'Rosto NAO cadastrado no sistema.'\n    }\n  }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
